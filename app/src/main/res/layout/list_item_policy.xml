<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="3dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/silver"
    app:strokeWidth="1dp"
    android:id="@+id/family_policies_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/policyProductCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/colorAccent"
                android:text="Product Code"
                android:textStyle="bold"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/policyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:text="Status"
                android:layout_alignParentStart="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/policyProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorPrimary"
            android:text="Product Name"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/EffectiveDate"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginRight="5dp"/>

            <TextView
                android:id="@+id/policyEffectiveDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-01"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginRight="15dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ExpireDate"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginRight="5dp"/>

            <TextView
                android:id="@+id/policyExpiryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-01-01"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/StartDate"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginRight="5dp"/>

            <TextView
                android:id="@+id/policyStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-01"
                android:textSize="10sp"
                android:layout_alignParentStart="true"
                android:layout_marginRight="15dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/PolicyValue"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginRight="5dp"/>

            <TextView
                android:id="@+id/policyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="value"/>

        </LinearLayout>

    </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end">

            <ImageView
                android:id="@+id/btnContextMenuPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/context_menu"
                android:layout_marginTop="10dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Menu"/>
        </LinearLayout>

    </LinearLayout>

    

</com.google.android.material.card.MaterialCardView>